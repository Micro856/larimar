[org.gnome.desktop.background]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/gnome/glass-chip-l.jxl'
picture-uri-dark='file:///usr/share/backgrounds/gnome/glass-chip-l.jxl'

[org.gnome.desktop.interface]
gtk-theme='adw-gtk3'

[org.gnome.desktop.screensaver]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/gnome/glass-chip-l.jxl'
primary-color='#26a269'
secondary-color='#000000'

[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,close'

[org.gnome.shell]
enabled-extensions=['gsconnect@andyholmes.github.io', 'blur-my-shell@aunetx', 'panel-workspace-scroll@polymeilex.github.io', 'rounded-window-corners@fxgn', 'gnome-fuzzy-app-search@gnome-shell-extensions.Czarlie.gitlab.com', 'static-workspace-background@CleoMenezesJr.github.io', 'Bluetooth-Battery-Meter@maniacx.github.com', 'tailscale-gnome@diskmth.fr', 'windowIsReady_Remover@nunofarruca@gmail.com']
always-show-log-out=true
favorite-apps=['org.gnome.Nautilus.desktop', 'com.google.Chrome.desktop', 'io.github.kolunmi.Bazaar.desktop']
